<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_models</name>
  <version>0.2.0</version>
  <description>
    Models of the MAB Robotics Honey Badger quadrupeds (hb40, hb50, hb50w):
    xacro/URDF, MuJoCo MJCF, RBDL Lua and meshes, with RViz and Gazebo Sim
    launch files and an Isaac Lab articulation config.
  </description>
  <maintainer email="krzysztof.kwapisz@mabrobotics.pl">Krzysztof Kwapisz</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://mabrobotics.github.io/hb-docs/intro.html</url>
  <url type="repository">https://github.com/mabrobotics/robot_models</url>
  <url type="bugtracker">https://github.com/mabrobotics/robot_models/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/../" />
  </export>
</package>
