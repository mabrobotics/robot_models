<?xml version="1.0"?>
<robot name="hb40" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- sim: none | mock | gazebo -->
  <xacro:arg name="sim" default="none" />

  <xacro:include filename="../common/_materials.xacro" />
  <xacro:include filename="_hb40_leg_macro.xacro" />

  <!-- Root link, free-floating base -->
  <link name="body">
    <inertial>
      <mass value="6.172" />
      <inertia ixx="0.028130" ixy="0" ixz="0" iyy="0.034812" iyz="0" izz="0.054102" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="${hb40_mesh_dir}/hb40.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <geometry>
        <box size="0.27 0.178 0.1" />
      </geometry>
      <material name="invisible" />
    </collision>
  </link>

  <!-- ================= FR (leg 0) ================= -->
  <xacro:hb40_leg
    prefix="fr"
    j0_xyz="0.1375 -0.064 0"
    l0_mesh="l0r.stl" l0_inertial_xyz="0.0557 0.016 0"
    j1_xyz="0.0555 -0.0125 0" j1_rpy="0 0 -1.570796"
    l1_mesh="l1r.stl" l1_inertial_xyz="0.031 -0.0164 -0.003"
    j2_xyz="0.0584 -0.2 0" j2_rpy="2.909001 0 0" j2_lower="-2.53" j2_upper="0"
    l2_mesh="l2r.stl" l2_material="red" l2_inertial_xyz="0.001 -0.104 -0.003"
    l2_collision1_xyz="0 0.01 0.0055" l2_collision1_rpy="1.3 0 0"
    l2_collision2_xyz="0 -0.1 0.005" l2_collision2_rpy="1.67 0 0.05"
    jFoot_xyz="0.0054 -0.2 0"
  />

  <!-- ================= FL (leg 1) ================= -->
  <xacro:hb40_leg
    prefix="fl"
    j0_xyz="0.1375 0.064 0"
    l0_mesh="l0l.stl" l0_inertial_xyz="0.0557 -0.016 0"
    j1_xyz="0.0555 0.0125 0" j1_rpy="0 0 1.570796"
    l1_mesh="l1lf.stl" l1_inertial_xyz="0.031 0.0164 -0.003"
    j2_xyz="0.0584 0.2 0" j2_rpy="-2.909001 0 0" j2_lower="0" j2_upper="2.53"
    l2_mesh="l2l.stl" l2_material="silver" l2_inertial_xyz="0.001 0.104 -0.003"
    l2_collision1_xyz="0 -0.01 0.0055" l2_collision1_rpy="-1.3 0 0"
    l2_collision2_xyz="0 0.1 0.005" l2_collision2_rpy="-1.67 0 -0.05"
    jFoot_xyz="0.0054 0.2 0"
  />

  <!-- ================= RL (leg 2) ================= -->
  <xacro:hb40_leg
    prefix="rl"
    j0_xyz="-0.1375 0.064 0" j0_rpy="0 0 -3.141593"
    l0_mesh="l0r.stl" l0_inertial_xyz="0.0557 0.016 0"
    j1_xyz="0.0555 -0.0125 0" j1_rpy="0 0 -1.570796"
    l1_mesh="l1lf.stl" l1_inertial_xyz="0.031 0.0164 -0.003"
    j2_xyz="0.0584 0.2 0" j2_rpy="-2.909001 0 0" j2_lower="0" j2_upper="2.53"
    l2_mesh="l2l.stl" l2_material="silver" l2_inertial_xyz="0.001 0.104 -0.003"
    l2_collision1_xyz="0 -0.01 0.0055" l2_collision1_rpy="-1.3 0 0"
    l2_collision2_xyz="0 0.1 0.005" l2_collision2_rpy="-1.67 0 -0.05"
    jFoot_xyz="0.0054 0.2 0"
  />

  <!-- ================= RR (leg 3) ================= -->
  <xacro:hb40_leg
    prefix="rr"
    j0_xyz="-0.1375 -0.064 0" j0_rpy="0 0 -3.141593"
    l0_mesh="l0l.stl" l0_inertial_xyz="0.0557 -0.016 0"
    j1_xyz="0.0555 0.0125 0" j1_rpy="0 0 1.570796"
    l1_mesh="l1r.stl" l1_inertial_xyz="0.031 -0.0164 -0.003"
    j2_xyz="0.0584 -0.2 0" j2_rpy="2.909001 0 0" j2_lower="-2.53" j2_upper="0"
    l2_mesh="l2r.stl" l2_material="silver" l2_inertial_xyz="0.001 -0.104 -0.003"
    l2_collision1_xyz="0 0.01 0.0055" l2_collision1_rpy="1.3 0 0"
    l2_collision2_xyz="0 -0.1 0.005" l2_collision2_rpy="1.67 0 0.05"
    jFoot_xyz="0.0054 -0.2 0"
  />

  <xacro:if value="${'$(arg sim)' != 'none'}">
    <xacro:include filename="../common/_ros2_control.xacro" />
    <xacro:ros2_control_block name="hb40" sim="$(arg sim)" />
  </xacro:if>

  <xacro:if value="${'$(arg sim)' == 'gazebo'}">
    <xacro:include filename="../common/_gazebo.xacro" />
    <xacro:gazebo_block robot="hb40" imu_xyz="0.049 0 0" />
  </xacro:if>

</robot>
