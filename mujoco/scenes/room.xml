<mujoco model="room terrain">
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="groundplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512"
      mark="cross" markrgb=".8 .8 .8"/>
    <material name="groundplane" reflectance="0.3" texture="groundplane" texrepeat="1 1" texuniform="true"/>
    <hfield name="room" file="../planes/room.png" size="2.75 3 1.8 0.01"/>
  </asset>

  <worldbody>
    <geom name="floor" type="hfield" size="0 0 1" pos="0 0 0" quat="1 0 0 0" material="groundplane" hfield="room"/>

    <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false"/>
    <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>

    <geom name="glass" type="box" size="2.75 0.01 0.9" pos="0 -3 0.9" rgba="1 1 1 0.1"/>
  </worldbody>
</mujoco>
